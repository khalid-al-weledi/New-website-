# ================= قاعدة البيانات (Supabase) =================
# من: Supabase → Project Settings → Database → Connection string
#
# 1) Transaction Pooler (المنفذ 6543) — للتطبيق في الإنتاج
#    أضف يدويًا: ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2) Direct / Session Pooler (المنفذ 5432) — للترحيلات فقط
DIRECT_URL="postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ================= المصادقة =================
# ولّدها بالأمر: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_32_BYTES"
NEXTAUTH_URL="http://localhost:3000"

# ================= Supabase Storage (رفع الإيصالات) =================
# من: Supabase → Project Settings → API
# ⚠️ Service Role Key سري — لا تضعه في كود العميل ولا تستخدم NEXT_PUBLIC_ معه
NEXT_PUBLIC_SUPABASE_URL="https://abcdefghijklmnop.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY_FROM_SUPABASE_SETTINGS"
SUPABASE_STORAGE_BUCKET="receipts"